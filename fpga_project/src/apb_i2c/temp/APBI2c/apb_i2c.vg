`pragma protect end_protected
module APB_I2C_Top (
  i2c_int,
  paddr,
  penable,
  prdata,
  psel,
  pwdata,
  pwrite,
  pready,
  pslverr,
  pclk,
  presetn,
  scl_o,
  sda_o,
  scl_i,
  sda_i
)
;
output i2c_int;
input [5:2] paddr;
input penable;
output [31:0] prdata;
input psel;
input [31:0] pwdata;
input pwrite;
output pready;
output pslverr;
input pclk;
input presetn;
output scl_o;
output sda_o;
input scl_i;
input sda_i;
wire VCC;
wire GND;
  \~apb_i2c.APB_I2C_Top  u_apb_i2c (
    .pclk(pclk),
    .pwrite(pwrite),
    .penable(penable),
    .psel(psel),
    .presetn(presetn),
    .sda_i(sda_i),
    .scl_i(scl_i),
    .pwdata_0(pwdata[0]),
    .pwdata_1(pwdata[1]),
    .pwdata_2(pwdata[2]),
    .pwdata_3(pwdata[3]),
    .pwdata_4(pwdata[4]),
    .pwdata_5(pwdata[5]),
    .pwdata_6(pwdata[6]),
    .pwdata_7(pwdata[7]),
    .pwdata_8(pwdata[8]),
    .pwdata_9(pwdata[9]),
    .pwdata_10(pwdata[10]),
    .pwdata_11(pwdata[11]),
    .pwdata_12(pwdata[12]),
    .pwdata_13(pwdata[13]),
    .pwdata_16(pwdata[16]),
    .pwdata_17(pwdata[17]),
    .pwdata_18(pwdata[18]),
    .pwdata_19(pwdata[19]),
    .pwdata_20(pwdata[20]),
    .pwdata_21(pwdata[21]),
    .pwdata_22(pwdata[22]),
    .pwdata_23(pwdata[23]),
    .pwdata_24(pwdata[24]),
    .pwdata_25(pwdata[25]),
    .pwdata_26(pwdata[26]),
    .pwdata_27(pwdata[27]),
    .pwdata_28(pwdata[28]),
    .paddr(paddr[5:2]),
    .i2c_int(i2c_int),
    .scl_o(scl_o),
    .sda_o(sda_o),
    .prdata_0(prdata[0]),
    .prdata_1(prdata[1]),
    .prdata_2(prdata[2]),
    .prdata_3(prdata[3]),
    .prdata_4(prdata[4]),
    .prdata_5(prdata[5]),
    .prdata_6(prdata[6]),
    .prdata_7(prdata[7]),
    .prdata_8(prdata[8]),
    .prdata_9(prdata[9]),
    .prdata_10(prdata[10]),
    .prdata_11(prdata[11]),
    .prdata_12(prdata[12]),
    .prdata_13(prdata[13]),
    .prdata_14(prdata[14]),
    .prdata_16(prdata[16]),
    .prdata_17(prdata[17]),
    .prdata_18(prdata[18]),
    .prdata_19(prdata[19]),
    .prdata_20(prdata[20]),
    .prdata_21(prdata[21]),
    .prdata_22(prdata[22]),
    .prdata_23(prdata[23]),
    .prdata_24(prdata[24]),
    .prdata_25(prdata[25]),
    .prdata_26(prdata[26]),
    .prdata_27(prdata[27]),
    .prdata_28(prdata[28])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
assign prdata[15] = GND;
assign prdata[29] = GND;
assign prdata[30] = GND;
assign prdata[31] = GND;
assign pready = VCC;
assign pslverr = GND;
endmodule /* APB_I2C_Top */
